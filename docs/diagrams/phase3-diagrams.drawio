        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor white\nskinparam linetype polyline\nskinparam nodesep 22\nskinparam ranksep 110\nskinparam ArrowColor black\nskinparam ArrowFontSize 10\nskinparam actor {\n BackgroundColor white\n BorderColor black\n FontColor black\n FontStyle bold\n FontSize 13\n}\nskinparam usecase {\n BackgroundColor white\n BorderColor black\n BorderThickness 1.5\n FontColor black\n FontSize 11\n}\nskinparam rectangle {\n BackgroundColor white\n BorderColor black\n BorderThickness 2\n FontColor black\n FontStyle bold\n FontSize 14\n}\n\ntitle Use Case Diagram - Inventory Process (To-Be)\n\nactor \&quot;Production Head\&quot; as PH\nactor \&quot;Sales Staff\&quot; as SS\nactor \&quot;Business Owner\&quot; as BO\n\nrectangle \&quot;Eli&#39;s Yummy Kitchen - Inventory System\&quot; {\n  usecase \&quot;UC-01 Record Production Output\&quot; as UC01\n  usecase \&quot;UC-02 Confirm Dispatch Received\&quot; as UC02\n  usecase \&quot;UC-03 Record Sale\&quot; as UC03\n  usecase \&quot;UC-04 Sync Offline Sales\&quot; as UC04\n  usecase \&quot;UC-05 Update Inventory Ledger\&quot; as UC05\n  usecase \&quot;UC-06 Count Stock on Hand\&quot; as UC06\n  usecase \&quot;UC-07 Enter Counted Quantities\&quot; as UC07\n  usecase \&quot;UC-08 Submit Daily Closing\&quot; as UC08\n  usecase \&quot;UC-09 Compare Expected Stock\\nwith Physical Count\&quot; as UC09\n  usecase \&quot;UC-10 Compute Expected Stock\&quot; as UC10\n  usecase \&quot;UC-11 Flag Discrepancy\&quot; as UC11\n  usecase \&quot;UC-12 View Discrepancy Notice\&quot; as UC12\n  usecase \&quot;UC-13 Review Discrepancy\&quot; as UC13\n  usecase \&quot;UC-14 Approve Stock Adjustment\&quot; as UC14\n  usecase \&quot;UC-15 Review Weekly Audit Report\&quot; as UC15\n  usecase \&quot;UC-16 Generate Weekly Audit Report\&quot; as UC16\n  usecase \&quot;UC-17 Sign Off &amp; Close Week\&quot; as UC17\n  usecase \&quot;UC-18 Set Opening Stock\&quot; as UC18\n}\n\nPH -- UC01\nSS -- UC02\nSS -- UC03\nSS -- UC06\nSS -- UC07\nSS -- UC08\nSS -- UC12\nUC13 -- BO\nUC14 -- BO\nUC15 -- BO\nUC17 -- BO\n\nUC01 ..&gt; UC05 : &lt;&lt;include&gt;&gt;\nUC02 ..&gt; UC05 : &lt;&lt;include&gt;&gt;\nUC03 ..&gt; UC05 : &lt;&lt;include&gt;&gt;\nUC14 .left.&gt; UC05 : &lt;&lt;include&gt;&gt;\nUC04 .up.&gt; UC03 : &lt;&lt;extend&gt;&gt;\nUC08 ..&gt; UC09 : &lt;&lt;include&gt;&gt;\nUC09 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\nUC11 .up.&gt; UC09 : &lt;&lt;extend&gt;&gt;\nUC14 .up.&gt; UC13 : &lt;&lt;extend&gt;&gt;\nUC15 .left.&gt; UC16 : &lt;&lt;include&gt;&gt;\nUC17 .left.&gt; UC18 : &lt;&lt;include&gt;&gt;\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hSvMIC1L7-jK1BjFwSUs-1">
