# Base URL of the backend API (no trailing slash).
# Leave empty for same-origin (dev uses the Vite proxy: /api -> http://localhost:5000).
# Set in production when the API is hosted separately, e.g. https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Optional: show quick-fill demo accounts on the login page (seeded by `npm run seed` in backend)
VITE_DEMO_ACCOUNTS=false
VITE_DEMO_PASSWORD=
