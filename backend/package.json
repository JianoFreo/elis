{
  "name": "eyk-backend",
  "version": "0.2.0",
  "description": "Eli's Yummy Kitchen Inventory & Sales API (SAD Group 3)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:reset": "tsx src/scripts/seed.ts --reset",
    "admin:create": "tsx src/scripts/createOwner.ts",
    "test:princess": "npm run build && node --experimental-test-module-mocks --import tsx --test-force-exit --test ../tests/princess/*.test.mjs",
    "test:princess:serve": "node --experimental-test-module-mocks ../tests/princess/serve.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
