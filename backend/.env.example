PORT=5000
NODE_ENV=development
# Neon pooled connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
# comma separated; empty = same-origin only
CORS_ORIGIN=
# true = also run syncSchema() on boot (adds columns, DROPS tables/columns not in TABLES)
IS_PRODUCTION=false

# the day dashboards call "today" (YYYY-MM-DD). Empty = real date. Use 2026-11-08 with the seeded sample week.
BUSINESS_DATE=

# only used by `npm run admin:create`
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
